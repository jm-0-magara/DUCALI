# M-Pesa Configuration (Kenyan Mobile Money)
# Copy these to your .env.local file and replace with your actual values

# M-Pesa API Credentials
MPESA_CONSUMER_KEY="your_mpesa_consumer_key_here"
MPESA_CONSUMER_SECRET="your_mpesa_consumer_secret_here"
MPESA_BUSINESS_SHORT_CODE="your_business_shortcode_here"
MPESA_PASSKEY="your_mpesa_passkey_here"

# Environment (use "sandbox" for testing, "live" for production)
MPESA_ENVIRONMENT="sandbox"

# App URL for callbacks
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: Stripe Configuration (if you want both payment methods)
# STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
# STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key"
# STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"
